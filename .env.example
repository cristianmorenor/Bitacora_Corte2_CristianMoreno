# Copiar este archivo como .env y poner valores propios. El archivo .env NO se sube a GitHub.

# PostgreSQL
DB_USER=brasa
DB_PASSWORD=cambia-esta-clave

# MongoDB: vacio = Mongo local del docker compose.
# Para Atlas: mongodb+srv://<usuario>:<clave>@<cluster>.mongodb.net/brasaviva?retryWrites=true&w=majority
MONGODB_URI=

# JWT: minimo 32 caracteres, aleatorio
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Primer usuario administrador
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave-admin
